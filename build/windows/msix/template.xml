<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="playgo"
        Arguments=""
        InstallLocation="C:\Program Files\Jae-Sung\PlayGo">
    </Installer>
    <PackageInformation
        PackageName="PlayGo"
        PackageDisplayName="PlayGo"
        PublisherName="CN=Jae-Sung"
        PublisherDisplayName="Jae-Sung"
        Version="0.1.0.0"
        PackageDescription="A simple streaming video player.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.jae_sung.playgo"
                Description="A simple streaming video player."
                DisplayName="PlayGo"
                ExecutableName="playgo"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>PlayGo</DisplayName>
            <PublisherDisplayName>Jae-Sung</PublisherDisplayName>
            <Description>A simple streaming video player.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="playgo.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
